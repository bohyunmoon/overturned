# Required for the AI reader (photo reading and tailored drafts).
# Without it the app runs in offline mode: paste-only, keyword reader, template letter.
ANTHROPIC_API_KEY=

# Only if the key is not scoped to a single workspace (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Optional. Defaults to claude-sonnet-5-5.
OVERTURNED_MODEL=
