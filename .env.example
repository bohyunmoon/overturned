# Required for the AI reader (photo reading and tailored drafts).
# Without it the app runs in offline mode: paste-only, keyword reader, template letter.
ANTHROPIC_API_KEY=

# Only if the key is not scoped to a single workspace (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# --- Protecting your bill ---------------------------------------------------
# Shared counters. Added automatically when you connect an Upstash Redis store
# from the Vercel Storage tab. Without them, limits are per server copy only
# and alerts are off.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email alerts through Resend (https://resend.com). ALERT_EMAIL must be the
# address you signed up to Resend with, unless ALERT_FROM uses a domain you
# have verified there.
RESEND_API_KEY=
ALERT_EMAIL=
# Optional. Defaults to "Overturned alerts <onboarding@resend.dev>".
ALERT_FROM=

# Optional phone push through ntfy (https://ntfy.sh) as well as, or instead of,
# email. Use a long, unguessable topic name: anyone who knows it can read the alerts.
NTFY_TOPIC=

# Optional overrides. Defaults: 30 per visitor per hour, 100 per visitor per
# day, 500 for the whole site per day (UTC).
RATE_IP_HOURLY=
RATE_IP_DAILY=
DAILY_AI_CAP=

# Optional. Defaults to claude-sonnet-5-5.
OVERTURNED_MODEL=
